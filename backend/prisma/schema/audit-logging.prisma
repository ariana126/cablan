// Read-side only: `audit-logging` has no aggregate or write model of its
// own. Every row here is a denormalized projection written by an
// `@EventsHandler` reacting to a mutating domain event already emitted by
// another module (identity, products, manufacturing-instructions, boms) — see src/modules/audit-logging/CLAUDE.md.
model AuditLogEntry {
  id         String   @id @default(uuid())
  occurredAt DateTime @map("occurred_at") @db.Timestamptz
  actorId    String   @map("actor_id")
  // A denormalized snapshot of the acting user's display name at the moment
  // of the event, resolved once via `DisplayNameProvider` — never a live
  // join back into `identity`'s `app_user`, so a later rename or deletion
  // never rewrites history. See `AuditLogProjector`.
  actorName String @map("actor_name")
  // 'User' | 'Product' | 'Component' | 'Material' | 'StandardBom' | 'Bom' —
  // plain `String`, not a Prisma enum, the same convention `app_user.role`
  // already uses; the finite set is enforced in the application layer
  // (`AuditRecordType`).
  recordType String @map("record_type")
  recordId   String @map("record_id")
  // 'Registered' | 'Edited' | 'Deleted' | 'Approved' | 'ApprovalRevoked' —
  // see `AuditAction`.
  action  String
  changes AuditLogEntryChange[]
  // The reference a reader identifies the record by (`trackingNumber` /
  // `TRK-3005`), shown beside the changes rather than among them. Both null
  // when the entry has none — every entry but a daily BOM's Approved /
  // ApprovalRevoked, and every row written before these columns existed.
  subjectField String? @map("subject_field")
  subjectValue String? @map("subject_value")
  // Monotonic insertion order: the list's tie-breaker after `occurredAt`, so
  // entries written at the same instant (an edit and the approval revocation
  // it caused, in one transaction under a pinned clock) still list
  // deterministically, newest-recorded first. Existing rows were numbered
  // when the column was added.
  sequence     Int     @default(autoincrement())

  // Three separate single-column indexes, not one composite: the list query
  // (`ListAuditLogHandler`) filters by any AND-combination of actorName,
  // recordId and an occurredAt range, and always sorts by occurredAt desc —
  // a composite index would only help the fully-filtered case, where these
  // let every filter (used alone or combined) reach for an index rather
  // than a sequential scan. The `occurredAt` one carries `sequence` as its
  // second column, matching the list's `occurredAt desc, sequence desc`.
  @@index([occurredAt, sequence])
  @@index([actorName])
  @@index([recordId])
  @@map("audit_log_entry")
}

// Never selected by the list query — only by
// `GET /api/audit-log/:id/changes` (`GetAuditLogChangesHandler`). Keeping
// this off the list query is what keeps that query "optimized": no join, no
// fetching change rows for a paginated list of entries.
model AuditLogEntryChange {
  id              String @id @default(uuid())
  auditLogEntryId String @map("audit_log_entry_id")
  field           String
  previousValue   String @map("previous_value")
  newValue        String @map("new_value")
  // The line's place within its entry (0-based), so a multi-line entry — a
  // registration's fields followed by one `component` line per component —
  // reads back in the order it was projected. Rows written before this
  // column existed all read 0.
  position        Int    @default(0)

  auditLogEntry AuditLogEntry @relation(fields: [auditLogEntryId], references: [id], onDelete: Cascade)

  @@map("audit_log_entry_change")
}
