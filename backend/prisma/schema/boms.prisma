// A daily BOM's composition is a clone, not a reference: `bom_component` and
// `bom_material` store a copy of the `componentId`/name and `materialId`/name
// read back from the referenced standard BOM's *current* composition at the
// moment of registration or editing — not a foreign key into
// `standard_bom`/`standard_bom_component`/`standard_bom_material`. Those rows
// (and the standard BOM itself) belong to `manufacturing-instructions.prisma`
// and can keep changing after a daily BOM has cloned them (see
// `BomCompositionFactory`'s doc comment and src/modules/boms/CLAUDE.md).
// `standardBomId` on `Bom` itself is the same kind of plain reference, for
// the same reason.
model Bom {
  id              String   @id @default(uuid())
  standardBomId   String   @map("standard_bom_id")
  // The referenced standard BOM's `miCode`/`brand`/`productName`/
  // `standardLength`, cloned at registration alongside `standardBomId`
  // itself — immutable afterwards, the same reasoning as the
  // component/material names cloned into `BomComponent`/`BomMaterial` below
  // (see the note atop this model). Read directly by the reporting queries
  // (`ReportBomsHandler`/`BomFilterOptionsHandler`/`GetBomHandler`) without a
  // live join back into `standard_bom`.
  standardBomMiCode String @map("standard_bom_mi_code")
  brand             String
  productName       String @map("product_name")
  standardLength    Float  @map("standard_length")
  orderNumber     String   @map("order_number")
  trackingNumber  String   @map("tracking_number")
  description     String?
  // The acting user's display name at registration, resolved by
  // `BomController.register()` through `UserNameProvider` — a clone, not a
  // reference to `app_user`, so a later rename never rewrites who a report
  // says registered this BOM. Immutable afterwards.
  registeredBy    String   @map("registered_by")
  // 'pending' | 'approved' | 'rejected' — `ApprovalStatus`' values, a plain
  // `String` like `audit_log_entry.action`. `reviewedBy` is the reviewer's
  // display name (whoever approved or rejected it), cloned like
  // `registeredBy`; null exactly when pending. `managementNote` is the
  // review's note — the reason on a rejection, the edits by any reviewer on
  // an approval (or none) — null when pending. `BomApproval.restore()`
  // rejects any other combination.
  approvalStatus  String   @default("pending") @map("approval_status")
  reviewedBy      String?  @map("reviewed_by")
  managementNote  String?  @map("management_note")
  // The edits by any reviewer during the current review, as
  // `PendingReviewChanges` stores them (a JSON array of `ReviewChange`) — kept
  // between the edit request and the approve request, which turns them into
  // `managementNote`.
  pendingReviewChanges Json @default("[]") @map("pending_review_changes")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz
  // Monotonic insertion order: registration order's tie-breaker after
  // `createdAt`, so daily BOMs registered at the same instant (a pinned test
  // clock) still have a first and a latest — what re-sampling («نمونه گیری
  // مجدد») turns on: only the latest daily BOM of a tracking number can be
  // re-sampled. Existing rows were numbered when the column was added.
  registrationSequence Int @default(autoincrement()) @map("registration_sequence")
  components      BomComponent[]

  // "Is there a later daily BOM of this tracking number?"
  @@index([trackingNumber, createdAt, registrationSequence])
  @@map("bom")
}

model BomComponent {
  id     String @id @default(uuid())
  bomId  String @map("bom_id")
  // The id of the standalone `Component` row this line was cloned from — not
  // a Prisma relation (see the note on `Bom` above).
  componentId String @map("component_id")
  name        String
  // Index of this component within its BOM, as the aggregate's array order
  // defined it — the order every read returns components in. Prisma
  // guarantees no order on an `include` without an `orderBy`.
  position    Int    @default(0)

  bom       Bom            @relation(fields: [bomId], references: [id], onDelete: Cascade)
  materials BomMaterial[]

  @@map("bom_component")
}

model BomMaterial {
  id             String @id @default(uuid())
  bomComponentId String @map("bom_component_id")
  // The id of the standalone `Material` row this line was cloned from — not
  // a Prisma relation, for the same reason as `BomComponent.componentId`.
  materialId     String @map("material_id")
  name           String
  weight         Float
  // Index of this material within its component, as the aggregate's array
  // order defined it — the order every read returns materials in.
  position       Int    @default(0)

  bomComponent BomComponent @relation(fields: [bomComponentId], references: [id], onDelete: Cascade)

  @@map("bom_material")
}
