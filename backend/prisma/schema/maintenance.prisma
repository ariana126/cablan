// CMMS, phase 1 (issue #69). Three aggregates: Equipment (with its PM plan
// items), MaintenanceActivity and MaintenanceExecution. No foreign key runs
// between aggregates: an execution copies the names it needs (ADR 0004).
// Equipment is retired rather than deleted; only the System Admin deletes
// retired equipment, and its executions with it (issue #110).

model Equipment {
  id        String   @id @default(uuid())
  // Retired equipment keeps its name taken, so a plain unique constraint;
  // the handlers refuse a taken name first and this is the backstop.
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  planItems     PmPlanItem[]
  serviceBreaks EquipmentServiceBreak[]

  @@map("equipment")
}

// Owned by `Equipment` (issue #110): each retirement and the reactivation
// that ended it, if any. The equipment is retired while its last break
// (highest `position`) has no `reactivated_at`. Replaced the old
// `equipment.retired_at`, whose rows became one open break each.
model EquipmentServiceBreak {
  equipmentId   String    @map("equipment_id")
  // 0-based, oldest first.
  position      Int
  retiredAt     DateTime  @map("retired_at") @db.Timestamptz(3)
  reactivatedAt DateTime? @map("reactivated_at") @db.Timestamptz(3)

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@id([equipmentId, position])
  @@map("equipment_service_break")
}

// Owned by `Equipment`. A deactivated item keeps its row (`removed_at`, the
// column's name from before "remove" became "deactivate"; kept so its
// hand-added partial unique index stays), so the executions recorded against
// it keep their meaning — until the System Admin deletes the inactive row
// with its executions, or its retired equipment (issue #110).
model PmPlanItem {
  id            String    @id @default(uuid())
  equipmentId   String    @map("equipment_id")
  // 0-based order the item was added in — the plan's display order.
  position      Int
  // The id of the `MaintenanceActivity` it schedules. Same module, but a
  // different aggregate, so no relation.
  activityId    String    @map("activity_id")
  // The activity's name when the item was added, for the audit trail's
  // lines; read models show the activity's current name.
  activityName  String    @map("activity_name")
  // `PmSchedule`'s segments, oldest first:
  // `[{ "startDueDate": "YYYY-MM-DD", "intervalDays": n }, …]`; a restart
  // given at reactivation (issue #110) also carries `"restartedOn"`.
  schedule      Json
  deactivatedAt DateTime? @map("removed_at") @db.Timestamptz(3)

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@unique([equipmentId, position])
  @@map("pm_plan_item")
}

model MaintenanceActivity {
  id        String   @id @default(uuid())
  name      String   @unique
  // `electrical` or `mechanical` (issue #108). Null only for an activity
  // registered before specialties existed, until the System Admin's one-time
  // assignment gives it one.
  specialty String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("maintenance_activity")
}

// The maintenance history. Snapshots the names it shows, so a later rename
// or plan change never rewrites it.
model MaintenanceExecution {
  id              String   @id @default(uuid())
  equipmentId     String   @map("equipment_id")
  equipmentName   String   @map("equipment_name")
  planItemId      String   @map("plan_item_id")
  activityId      String   @map("activity_id")
  activityName    String   @map("activity_name")
  // The occurrence it was recorded for — a calendar date, no time of day.
  dueDate         DateTime @map("due_date") @db.Date
  performedAt     DateTime @map("performed_at") @db.Timestamptz(3)
  performedById   String   @map("performed_by_id")
  performedByName String   @map("performed_by_name")
  notes           String?
  // The equipment's operating hours the performer reported (issue #108):
  // 0 to 1,000,000, two decimals. Null when none was given.
  operatingHours  Decimal? @map("operating_hours") @db.Decimal(9, 2)

  // One execution per occurrence: the backstop for two recordings at once
  // both targeting the same due date.
  @@unique([planItemId, dueDate])
  @@index([equipmentId])
  @@map("maintenance_execution")
}
