# language: fa
قابلیت: ثبت انجام فعالیت های QC حین تولید
  بازرس کنترل کیفیت انجام هر فعالیت QC تجهیز را همراه شماره ردیابی ثبت می کند
  و آخرین انجام فعالیت ها را می بیند تا بازرسی های بعدی خود را زمان بندی کند

  پیش زمینه:
    با در نظر گرفتن اینکه تجهیز "اکسترودر 1" در سیستم ثبت شده باشد
    و فعالیت های QC "بازرسی ابعادی" و "بازرسی ظاهری" به تجهیز "اکسترودر 1" تخصیص داده شده باشند

  سناریو: ثبت انجام یک فعالیت QC با شماره ردیابی
    با در نظر گرفتن اینکه اکنون "1405/07/01" ساعت "08:00" باشد
    و نیکروش وارد سیستم شده باشد
    وقتی نیکروش انجام "بازرسی ابعادی" روی "اکسترودر 1" را با شماره ردیابی "TR-100" ثبت می کند
    انتظار می رود سوابق انجام QC تجهیز "اکسترودر 1" به صورت زیر باشد
      | فعالیت        | ثبت کننده | زمان ثبت         | شماره ردیابی | توضیحات |
      | بازرسی ابعادی | نیکروش    | 1405/07/01 08:00 | TR-100       | -       |
    و هیچ انجامی برای "بازرسی ظاهری" روی "اکسترودر 1" ثبت نشده باشد

  سناریو: ثبت انجام همراه با توضیحات
    با در نظر گرفتن اینکه نیکروش وارد سیستم شده باشد
    وقتی نیکروش انجام "بازرسی ظاهری" روی "اکسترودر 1" را با شماره ردیابی "TR-100" و توضیحات "خراش جزئی روی روکش" ثبت می کند
    انتظار می رود توضیحات آخرین سابقه انجام "بازرسی ظاهری" روی "اکسترودر 1" "خراش جزئی روی روکش" باشد

  قانون: فقط بازرس کنترل کیفیت، مدیریت، مدیر کارخانه و مدیر سیستم انجام فعالیت QC را ثبت می کنند

    الگوی سناریو: ثبت انجام توسط کاربر مجاز
      با در نظر گرفتن اینکه <کاربر> وارد سیستم شده باشد
      وقتی <کاربر> انجام "بازرسی ابعادی" روی "اکسترودر 1" را با شماره ردیابی "TR-100" ثبت می کند
      انتظار می رود سابقه انجام "بازرسی ابعادی" روی "اکسترودر 1" با ثبت کننده <کاربر> ثبت شده باشد

      نمونه ها:
        | کاربر   |
        | نیکروش  |
        | مصطفی   |
        | یاشار   |
        | کامرانی |

    الگوی سناریو: تلاش کاربر بدون دسترسی برای ثبت انجام
      با در نظر گرفتن اینکه <کاربر> وارد سیستم شده باشد
      وقتی <کاربر> تلاش می کند انجام "بازرسی ابعادی" روی "اکسترودر 1" را با شماره ردیابی "TR-100" ثبت کند
      انتظار می رود هیچ انجامی برای "بازرسی ابعادی" روی "اکسترودر 1" ثبت نشده باشد
      و پیغام خطای عدم دسترسی نشان داده شود

      نمونه ها:
        | کاربر   |
        | رضازاده |
        | مسلمی   |
        | سینا    |

  قانون: شماره ردیابی برای هر ثبت لازم است و می تواند هر متنی باشد

    الگوی سناریو: ثبت انجام بدون شماره ردیابی
      با در نظر گرفتن اینکه نیکروش وارد سیستم شده باشد
      وقتی نیکروش تلاش می کند انجام "بازرسی ابعادی" روی "اکسترودر 1" را با شماره ردیابی "<شماره ردیابی>" ثبت کند
      انتظار می رود هیچ انجامی برای "بازرسی ابعادی" روی "اکسترودر 1" ثبت نشده باشد
      و پیغام خطای شماره ردیابی نشان داده شود

      نمونه ها:
        | شماره ردیابی |
        |              |
        |              |

    مثال: شماره ردیابی که در هیچ آنالیز روزانه ای نیامده است
      با در نظر گرفتن اینکه هیچ آنالیز روزانه ای با شماره ردیابی "TR-999" ثبت نشده باشد
      و نیکروش وارد سیستم شده باشد
      وقتی نیکروش انجام "بازرسی ابعادی" روی "اکسترودر 1" را با شماره ردیابی "TR-999" ثبت می کند
      انتظار می رود سابقه انجام "بازرسی ابعادی" روی "اکسترودر 1" با شماره ردیابی "TR-999" ثبت شده باشد

  قانون: فقط فعالیتی که به یک تجهیز فعال تخصیص داده شده قابل ثبت است

    الگوی سناریو: تلاش برای ثبت انجام فعالیتی که قابل انجام نیست
      با در نظر گرفتن اینکه فعالیت QC "تست کشش" تعریف شده باشد
      و <وضعیت>
      و نیکروش وارد سیستم شده باشد
      وقتی نیکروش تلاش می کند انجام "<فعالیت>" روی "اکسترودر 1" را با شماره ردیابی "TR-100" ثبت کند
      انتظار می رود هیچ انجامی برای "<فعالیت>" روی "اکسترودر 1" ثبت نشده باشد
      و به او گفته شود که <پیغام>

      نمونه ها:
        | وضعیت                                                                       | فعالیت        | پیغام                                              |
        | فعالیت QC "تست کشش" به تجهیز "اکسترودر 1" تخصیص داده نشده باشد            | تست کشش       | "تست کشش" به "اکسترودر 1" تخصیص داده نشده است     |
        | تخصیص فعالیت QC "بازرسی ابعادی" از تجهیز "اکسترودر 1" برداشته شده باشد   | بازرسی ابعادی | "بازرسی ابعادی" به "اکسترودر 1" تخصیص داده نشده است |
        | تجهیز "اکسترودر 1" کنار گذاشته شده باشد                                    | بازرسی ابعادی | "اکسترودر 1" کنار گذاشته شده است                  |

  قانون: ثبت هر فعالیت مستقل است و بین دو انجام محدودیت زمانی نیست

    مثال: ثبت دوباره همان فعالیت چند دقیقه بعد
      با در نظر گرفتن اینکه نیکروش انجام "بازرسی ابعادی" روی "اکسترودر 1" را در "1405/07/01" ساعت "08:00" ثبت کرده باشد
      و اکنون "1405/07/01" ساعت "08:05" باشد
      وقتی نیکروش انجام "بازرسی ابعادی" روی "اکسترودر 1" را با شماره ردیابی "TR-101" ثبت می کند
      انتظار می رود 2 سابقه انجام "بازرسی ابعادی" روی "اکسترودر 1" ثبت شده باشد
      و هیچ انجامی برای "بازرسی ظاهری" روی "اکسترودر 1" ثبت نشده باشد

  قانون: آخرین انجام هر فعالیت تجهیز برای زمان بندی بازرسی دیده می شود

    مثال: آخرین انجام فعالیت هایی که یکی از آن ها سابقه ندارد
      با در نظر گرفتن اینکه نیکروش انجام "بازرسی ابعادی" روی "اکسترودر 1" را در "1405/07/01" ساعت "08:00" و "1405/07/01" ساعت "10:00" ثبت کرده باشد
      وقتی نیکروش فعالیت های QC تجهیز "اکسترودر 1" را مشاهده می کند
      انتظار می رود آخرین انجام فعالیت های QC تجهیز "اکسترودر 1" به صورت زیر باشد
        | فعالیت        | آخرین انجام      |
        | بازرسی ابعادی | 1405/07/01 10:00 |
        | بازرسی ظاهری  | بدون سابقه       |

    مثال: به روز شدن آخرین انجام پس از ثبت تازه
      با در نظر گرفتن اینکه نیکروش انجام "بازرسی ظاهری" روی "اکسترودر 1" را در "1405/07/01" ساعت "08:00" ثبت کرده باشد
      و اکنون "1405/07/01" ساعت "11:30" باشد
      وقتی نیکروش انجام "بازرسی ظاهری" روی "اکسترودر 1" را با شماره ردیابی "TR-200" ثبت می کند
      انتظار می رود آخرین انجام "بازرسی ظاهری" روی "اکسترودر 1" "1405/07/01 11:30" باشد

  قانون: QR چاپ شده یک تجهیز با اصلاح نام یا دریافت دوباره QR بی اعتبار نمی شود

    مثال: اسکن QR قدیمی پس از اصلاح نام تجهیز
      با در نظر گرفتن اینکه QR تجهیز "اکسترودر 1" چاپ شده باشد
      و یاشار نام تجهیز "اکسترودر 1" را به "اکسترودر خط یک" اصلاح کرده و QR آن را دوباره دریافت کرده باشد
      و نیکروش وارد سیستم شده باشد
      وقتی نیکروش QR چاپ شده قبلی را اسکن می کند
      انتظار می رود فعالیت های QC تجهیز "اکسترودر خط یک" به او نشان داده شود
