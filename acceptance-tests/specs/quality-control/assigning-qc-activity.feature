# language: fa
قابلیت: تخصیص فعالیت های QC به تجهیزات
  مدیریت فعالیت های QC تعریف شده را به تجهیزات تخصیص می دهد
  تا بازرس بداند روی هر تجهیز کدام بازرسی ها را باید انجام و ثبت کند

  پیش زمینه:
    با در نظر گرفتن اینکه تجهیزهای "اکسترودر 1" و "اکسترودر 2" در سیستم ثبت شده باشند
    و فعالیت های QC "بازرسی ابعادی" و "بازرسی ظاهری" تعریف شده باشند
    و مصطفی وارد سیستم شده باشد

  سناریو: تخصیص یک فعالیت QC به چند تجهیز
    وقتی مصطفی فعالیت QC "بازرسی ابعادی" را به تجهیزهای "اکسترودر 1" و "اکسترودر 2" تخصیص می دهد
    انتظار می رود فعالیت های QC تجهیز "اکسترودر 1" فقط "بازرسی ابعادی" باشد
    و فعالیت های QC تجهیز "اکسترودر 2" فقط "بازرسی ابعادی" باشد

  سناریو: تخصیص چند فعالیت QC به یک تجهیز
    وقتی مصطفی فعالیت های QC "بازرسی ابعادی" و "بازرسی ظاهری" را به تجهیز "اکسترودر 1" تخصیص می دهد
    انتظار می رود فعالیت های QC تجهیز "اکسترودر 1" "بازرسی ابعادی" و "بازرسی ظاهری" باشند

  قانون: یک فعالیت QC دو بار به یک تجهیز تخصیص داده نمی شود

    مثال: تخصیص تکراری فعالیت QC به همان تجهیز
      با در نظر گرفتن اینکه فعالیت QC "بازرسی ابعادی" به تجهیز "اکسترودر 1" تخصیص داده شده باشد
      وقتی مصطفی فعالیت QC "بازرسی ابعادی" را به تجهیز "اکسترودر 1" تخصیص می دهد
      انتظار می رود فعالیت QC "بازرسی ابعادی" فقط یک بار در فعالیت های QC تجهیز "اکسترودر 1" باشد
      و پیغام خطای تکراری بودن تخصیص نشان داده شود

  قانون: فقط مدیریت، مدیر کارخانه و مدیر سیستم فعالیت QC را به تجهیز تخصیص می دهند یا تخصیص آن را برمی دارند

    مثال: تخصیص فعالیت QC توسط مدیر کارخانه
      با در نظر گرفتن اینکه کامرانی وارد سیستم شده باشد
      وقتی کامرانی فعالیت QC "بازرسی ابعادی" را به تجهیز "اکسترودر 1" تخصیص می دهد
      انتظار می رود فعالیت QC "بازرسی ابعادی" به تجهیز "اکسترودر 1" تخصیص داده شده باشد

    الگوی سناریو: برداشتن تخصیص توسط کاربر مجاز
      با در نظر گرفتن اینکه فعالیت QC "بازرسی ابعادی" به تجهیز "اکسترودر 1" تخصیص داده شده باشد
      و <کاربر> وارد سیستم شده باشد
      وقتی <کاربر> تخصیص فعالیت QC "بازرسی ابعادی" را از تجهیز "اکسترودر 1" برمی دارد
      انتظار می رود فعالیت QC "بازرسی ابعادی" در فعالیت های QC تجهیز "اکسترودر 1" نباشد

      نمونه ها:
        | کاربر |
        | مصطفی |
        | یاشار |

    الگوی سناریو: تلاش کاربر بدون دسترسی برای تخصیص یا برداشتن تخصیص
      با در نظر گرفتن اینکه فعالیت QC "بازرسی ابعادی" به تجهیز "اکسترودر 1" تخصیص داده شده باشد
      و <کاربر> وارد سیستم شده باشد
      وقتی <کاربر> تلاش می کند <تغییر>
      انتظار می رود فعالیت های QC تجهیز "اکسترودر 1" تغییر نکرده باشد
      و پیغام خطای عدم دسترسی نشان داده شود

      نمونه ها:
        | کاربر   | تغییر                                                                     |
        | نیکروش  | فعالیت QC "بازرسی ظاهری" را به تجهیز "اکسترودر 1" تخصیص دهد              |
        | نیکروش  | تخصیص فعالیت QC "بازرسی ابعادی" را از تجهیز "اکسترودر 1" بردارد         |
        | رضازاده | فعالیت QC "بازرسی ظاهری" را به تجهیز "اکسترودر 1" تخصیص دهد              |
        | رضازاده | تخصیص فعالیت QC "بازرسی ابعادی" را از تجهیز "اکسترودر 1" بردارد         |
        | مسلمی   | فعالیت QC "بازرسی ظاهری" را به تجهیز "اکسترودر 1" تخصیص دهد              |
        | سینا    | فعالیت QC "بازرسی ظاهری" را به تجهیز "اکسترودر 1" تخصیص دهد              |

  قانون: برداشتن تخصیص فقط ثبت انجام تازه آن فعالیت روی همان تجهیز را متوقف می کند و هیچ سابقه ای را پاک نمی کند

    مثال: برداشتن تخصیص از یک تجهیز
      با در نظر گرفتن اینکه فعالیت QC "بازرسی ابعادی" به تجهیزهای "اکسترودر 1" و "اکسترودر 2" تخصیص داده شده باشد
      و نیکروش انجام "بازرسی ابعادی" روی "اکسترودر 1" را در "1405/07/01" ساعت "08:00" با شماره ردیابی "TR-100" ثبت کرده باشد
      وقتی مصطفی تخصیص فعالیت QC "بازرسی ابعادی" را از تجهیز "اکسترودر 1" برمی دارد
      انتظار می رود انجام "بازرسی ابعادی" دیگر روی تجهیز "اکسترودر 1" قابل ثبت نباشد
      و فعالیت QC "بازرسی ابعادی" همچنان به تجهیز "اکسترودر 2" تخصیص داده شده باشد
      و فعالیت QC "بازرسی ابعادی" همچنان در سیستم ثبت شده باشد
      و سوابق انجام QC تجهیز "اکسترودر 1" به صورت زیر باشد
        | فعالیت        | ثبت کننده | زمان ثبت         | شماره ردیابی |
        | بازرسی ابعادی | نیکروش    | 1405/07/01 08:00 | TR-100       |

    مثال: تخصیص دوباره فعالیتی که تخصیص آن برداشته شده
      با در نظر گرفتن اینکه نیکروش انجام "بازرسی ابعادی" روی "اکسترودر 1" را در "1405/07/01" ساعت "08:00" با شماره ردیابی "TR-100" ثبت کرده باشد
      و تخصیص فعالیت QC "بازرسی ابعادی" از تجهیز "اکسترودر 1" برداشته شده باشد
      وقتی مصطفی فعالیت QC "بازرسی ابعادی" را دوباره به تجهیز "اکسترودر 1" تخصیص می دهد
      انتظار می رود انجام "بازرسی ابعادی" روی تجهیز "اکسترودر 1" دوباره قابل ثبت باشد
      و سابقه انجام "بازرسی ابعادی" در "1405/07/01" ساعت "08:00" همچنان در سوابق انجام QC تجهیز "اکسترودر 1" باشد

  قانون: به تجهیز کنار گذاشته شده فعالیت QC تازه تخصیص داده نمی شود ولی سوابق QC آن دیده می شود

    مثال: تلاش برای تخصیص فعالیت QC به تجهیز کنار گذاشته شده
      با در نظر گرفتن اینکه تجهیز "اکسترودر 1" کنار گذاشته شده باشد
      وقتی مصطفی تلاش می کند فعالیت QC "بازرسی ابعادی" را به تجهیز "اکسترودر 1" تخصیص دهد
      انتظار می رود فعالیت QC "بازرسی ابعادی" در فعالیت های QC تجهیز "اکسترودر 1" نباشد
      و به او گفته شود که "اکسترودر 1" کنار گذاشته شده است

    مثال: سوابق QC تجهیز کنار گذاشته شده دیده می شود
      با در نظر گرفتن اینکه نیکروش انجام "بازرسی ابعادی" روی "اکسترودر 1" را در "1405/07/01" ساعت "08:00" با شماره ردیابی "TR-100" ثبت کرده باشد
      و تجهیز "اکسترودر 1" کنار گذاشته شده باشد
      وقتی مصطفی پرونده QC تجهیز "اکسترودر 1" را مشاهده می کند
      انتظار می رود سابقه انجام "بازرسی ابعادی" در "1405/07/01" ساعت "08:00" در سوابق انجام QC تجهیز "اکسترودر 1" باشد

  قانون: مدیر سیستم تجهیز کنار گذاشته شده را همراه تخصیص ها و سوابق QC آن حذف می کند و تجهیز دوباره فعال شده فعالیت های QC قبلی خود را دارد

    مثال: حذف تجهیز کنار گذاشته شده دارای سابقه QC
      با در نظر گرفتن اینکه فعالیت QC "بازرسی ابعادی" به تجهیزهای "اکسترودر 1" و "اکسترودر 2" تخصیص داده شده باشد
      و نیکروش انجام "بازرسی ابعادی" روی "اکسترودر 1" را 3 بار ثبت کرده باشد
      و تجهیز "اکسترودر 1" کنار گذاشته شده باشد
      و یاشار وارد سیستم شده باشد
      وقتی یاشار تجهیز "اکسترودر 1" را حذف می کند
      انتظار می رود تجهیز "اکسترودر 1" در سیستم نباشد
      و هیچ سابقه انجام QC برای "اکسترودر 1" در سوابق فعالیت های QC نباشد
      و فعالیت QC "بازرسی ابعادی" همچنان به تجهیز "اکسترودر 2" تخصیص داده شده باشد

    مثال: فعال کردن دوباره تجهیز دارای فعالیت QC
      با در نظر گرفتن اینکه فعالیت QC "بازرسی ابعادی" به تجهیز "اکسترودر 1" تخصیص داده شده باشد
      و تجهیز "اکسترودر 1" کنار گذاشته شده باشد
      و یاشار وارد سیستم شده باشد
      وقتی یاشار تجهیز "اکسترودر 1" را دوباره فعال می کند
      انتظار می رود انجام "بازرسی ابعادی" روی تجهیز "اکسترودر 1" دوباره قابل ثبت باشد
