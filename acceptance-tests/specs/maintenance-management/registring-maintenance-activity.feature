# language: fa
قابلیت: تعریف فعالیت های تعمیرات و نگهداری
  مدیر فنی هر فعالیت تعمیرات و نگهداری را یک بار تعریف می کند
  تا همان فعالیت در برنامه تجهیزات مختلف به کار برود

  پیش زمینه:
    با در نظر گرفتن اینکه رضازاده وارد سیستم شده باشد

  سناریو: ثبت فعالیت جدید
    وقتی رضازاده فعالیت جدیدی با نام "تعویض روغن" و تخصص "مکانیک" ثبت می کند
    انتظار می رود فعالیت "تعویض روغن" با تخصص "مکانیک" در سیستم ثبت شده باشد

  سناریو: تغییر تخصص فعالیت
    با در نظر گرفتن اینکه فعالیتی با نام "بررسی تابلو برق" و تخصص "مکانیک" در سیستم ثبت شده باشد
    وقتی رضازاده تخصص فعالیت "بررسی تابلو برق" را به "برق" تغییر می دهد
    انتظار می رود فعالیت "بررسی تابلو برق" با تخصص "برق" در سیستم ثبت شده باشد

  سناریو: ویرایش نام فعالیت
    با در نظر گرفتن اینکه فعالیتی با نام "بررسی تابلو برق" در سیستم ثبت شده باشد
    وقتی رضازاده نام فعالیت "بررسی تابلو برق" را به "بررسی و آچارکشی تابلو برق" تغییر می دهد
    انتظار می رود فعالیت "بررسی و آچارکشی تابلو برق" در سیستم ثبت شده باشد

  قانون: فقط مدیر فنی و مدیر سیستم مجاز به ثبت و ویرایش فعالیت ها هستند

    الگوی سناریو: تلاش کاربر بدون دسترسی برای ثبت فعالیت جدید
      با در نظر گرفتن اینکه <کاربر> وارد سیستم شده باشد
      وقتی <کاربر> تلاش می کند فعالیت جدیدی ثبت کند
      انتظار می رود فعالیت جدیدی ثبت نشده باشد
      و پیغام خطای عدم دسترسی نشان داده شود

      نمونه ها:
        | کاربر  |
        | مسلمی  |
        | مصطفی  |
        | نیکروش |
        | سینا   |

    الگوی سناریو: تلاش کاربر بدون دسترسی برای ویرایش فعالیت
      با در نظر گرفتن اینکه فعالیتی با نام "تعویض روغن" در سیستم ثبت شده باشد
      و <کاربر> وارد سیستم شده باشد
      وقتی <کاربر> تلاش می کند نام فعالیت "تعویض روغن" را تغییر دهد
      انتظار می رود فعالیت ویرایش نشده باشد
      و پیغام خطای عدم دسترسی نشان داده شود

      نمونه ها:
        | کاربر  |
        | مسلمی  |
        | مصطفی  |
        | نیکروش |
        | سینا   |

  قانون: هر فعالیت باید دقیقا یکی از دو تخصص برق یا مکانیک را داشته باشد

    الگوی سناریو: ثبت فعالیت بدون یک تخصص مشخص
      وقتی رضازاده فعالیت جدیدی با نام "بررسی تابلو برق" <تخصص> ثبت می کند
      انتظار می رود فعالیت جدیدی ثبت نشده باشد
      و پیغام خطای تخصص فعالیت نشان داده شود

      نمونه ها:
        | تخصص                       |
        | بدون تخصص                  |
        | با هر دو تخصص برق و مکانیک |

  قانون: نام فعالیت نمی تواند خالی باشد

    مثال: ثبت فعالیت بدون نام
      وقتی رضازاده اطلاعات فعالیت جدید را وارد می کند
      اما نام فعالیت را خالی می گذارد
      انتظار می رود فعالیت جدیدی ثبت نشده باشد
      و پیغام خطای نام فعالیت نشان داده شود

  قانون: نام هر فعالیت باید یکتا باشد

    مثال: ثبت فعالیت با نام تکراری
      با در نظر گرفتن اینکه فعالیتی با نام "تعویض روغن" و تخصص "مکانیک" در سیستم ثبت شده باشد
      وقتی رضازاده فعالیت جدیدی با نام "تعویض روغن" و تخصص "برق" ثبت می کند
      انتظار می رود فعالیت جدیدی ثبت نشده باشد
      و پیغام خطای تکراری بودن نام فعالیت نشان داده شود

    مثال: ویرایش نام فعالیت به نامی تکراری
      با در نظر گرفتن اینکه فعالیتی با نام "تعویض روغن" و فعالیت دیگری با نام "بررسی تابلو برق" در سیستم ثبت شده باشد
      وقتی رضازاده نام فعالیت "بررسی تابلو برق" را به "تعویض روغن" تغییر می دهد
      انتظار می رود فعالیت ویرایش نشده باشد
      و پیغام خطای تکراری بودن نام فعالیت نشان داده شود

  قانون: فعالیتی که در برنامه PM تجهیزی آمده یا سابقه انجام دارد قابل ویرایش نیست

    الگوی سناریو: تلاش برای تغییر نام فعالیتی که در برنامه PM آمده است
      با در نظر گرفتن اینکه فعالیت "تعویض روغن" با دوره "30" روز و اولین موعد "1405/07/01" در برنامه تجهیز "اکسترودر 1" <وضعیت>
      وقتی رضازاده تلاش می کند نام فعالیت "تعویض روغن" را به "تعویض روغن و فیلتر" تغییر دهد
      انتظار می رود فعالیت "تعویض روغن" ویرایش نشده باشد
      و به او گفته شود که "تعویض روغن" در برنامه PM 1 تجهیز استفاده شده است

      نمونه ها:
        | وضعیت                 |
        | باشد                  |
        | بوده و غیرفعال شده باشد |

    الگوی سناریو: تلاش برای تغییر تخصص فعالیتی که در برنامه PM آمده است
      با در نظر گرفتن اینکه فعالیتی با نام "تعویض روغن" و تخصص "مکانیک" در سیستم ثبت شده باشد
      و فعالیت "تعویض روغن" با دوره "30" روز و اولین موعد "1405/07/01" در برنامه تجهیز "اکسترودر 1" <وضعیت>
      وقتی رضازاده تلاش می کند تخصص فعالیت "تعویض روغن" را به "برق" تغییر دهد
      انتظار می رود فعالیت "تعویض روغن" با تخصص "مکانیک" باقی مانده باشد
      و به او گفته شود که "تعویض روغن" در برنامه PM 1 تجهیز استفاده شده است

      نمونه ها:
        | وضعیت                   |
        | باشد                    |
        | بوده و غیرفعال شده باشد |

  قانون: تخصص فعالیت های قبلی را مدیر سیستم یک بار و برای همه آن ها با هم تعیین می کند و این تخصص به سوابق انجام آن ها هم اضافه می شود و چیز دیگری از برنامه ها و سوابق تغییر نمی کند

    مثال: تعیین تخصص همه فعالیت های قبلی
      با در نظر گرفتن اینکه فعالیت های "تعویض روغن" و "بررسی تابلو برق" پیش از تعیین تخصص ثبت شده باشند و تخصصی نداشته باشند
      و فعالیت "تعویض روغن" با دوره "7" روز و اولین موعد "1405/07/01" در برنامه تجهیز "اکسترودر 1" باشد
      و مسلمی انجام تعویض روغن اکسترودر 1 برای موعد "1405/07/01" را در "1405/07/01" ثبت کرده باشد
      و یاشار وارد سیستم شده باشد
      وقتی یاشار تخصص فعالیت های قبلی را به صورت زیر تعیین می کند
        | فعالیت          | تخصص   |
        | تعویض روغن      | مکانیک |
        | بررسی تابلو برق | برق    |
      انتظار می رود فعالیت "تعویض روغن" با تخصص "مکانیک" در سیستم ثبت شده باشد
      و فعالیت "بررسی تابلو برق" با تخصص "برق" در سیستم ثبت شده باشد
      و سابقه تعمیرات اکسترودر 1 به صورت زیر باشد
        | فعالیت     | تخصص   | موعد       | انجام دهنده |
        | تعویض روغن | مکانیک | 1405/07/01 | مسلمی       |
      و برنامه تجهیز "اکسترودر 1" تغییری نکرده باشد

    مثال: تعیین تخصص فقط بخشی از فعالیت های قبلی
      با در نظر گرفتن اینکه فعالیت های "تعویض روغن" و "بررسی تابلو برق" پیش از تعیین تخصص ثبت شده باشند و تخصصی نداشته باشند
      و یاشار وارد سیستم شده باشد
      وقتی یاشار فقط تخصص فعالیت "تعویض روغن" را "مکانیک" تعیین می کند
      انتظار می رود فعالیت های "تعویض روغن" و "بررسی تابلو برق" همچنان تخصصی نداشته باشند
      و پیغام خطای تعیین نشدن تخصص همه فعالیت ها نشان داده شود

    مثال: تخصص فعالیت قبلی پس از تعیین دیگر تغییر نمی کند
      با در نظر گرفتن اینکه فعالیت "تعویض روغن" پیش از تعیین تخصص ثبت شده باشد و تخصصی نداشته باشد
      و فعالیت "تعویض روغن" با دوره "7" روز و اولین موعد "1405/07/01" در برنامه تجهیز "اکسترودر 1" باشد
      و یاشار تخصص فعالیت "تعویض روغن" را "مکانیک" تعیین کرده باشد
      وقتی یاشار تلاش می کند تخصص فعالیت "تعویض روغن" را به "برق" تغییر دهد
      انتظار می رود فعالیت "تعویض روغن" با تخصص "مکانیک" باقی مانده باشد
      و به او گفته شود که "تعویض روغن" در برنامه PM 1 تجهیز استفاده شده است

    الگوی سناریو: تلاش کاربری غیر از مدیر سیستم برای تعیین تخصص فعالیت های قبلی
      با در نظر گرفتن اینکه فعالیت "تعویض روغن" پیش از تعیین تخصص ثبت شده باشد و تخصصی نداشته باشد
      و <کاربر> وارد سیستم شده باشد
      وقتی <کاربر> تلاش می کند تخصص فعالیت قبلی "تعویض روغن" را "مکانیک" تعیین کند
      انتظار می رود فعالیت "تعویض روغن" همچنان تخصصی نداشته باشد
      و پیغام خطای عدم دسترسی نشان داده شود

      نمونه ها:
        | کاربر   |
        | رضازاده |
        | مسلمی   |

  قانون: مدیر سیستم نام فعالیتی را که در برنامه PM آمده یا سابقه انجام دارد اصلاح می کند و اصلاح در برنامه ها و سوابق آن اعمال می شود

    مثال: اصلاح نام فعالیتی که در برنامه و سابقه تعمیرات آمده است
      با در نظر گرفتن اینکه فعالیت "تعویض روغن" با دوره "7" روز و اولین موعد "1405/07/01" در برنامه تجهیز "اکسترودر 1" باشد
      و مسلمی انجام تعویض روغن اکسترودر 1 را در "1405/07/01" ساعت "09:00" ثبت کرده باشد
      و یاشار وارد سیستم شده باشد
      وقتی یاشار نام فعالیت "تعویض روغن" را به "تعویض روغن و فیلتر" تغییر می دهد و اعمال آن در اطلاعات و سوابق مرتبط را تایید می کند
      انتظار می رود فعالیت "تعویض روغن و فیلتر" با دوره "7" روز در برنامه تجهیز "اکسترودر 1" باشد
      و سابقه تعمیرات اکسترودر 1 به صورت زیر باشد
        | فعالیت               | موعد       | انجام دهنده | زمان انجام        | وضعیت |
        | تعویض روغن و فیلتر | 1405/07/01 | مسلمی       | 1405/07/01 09:00 | بموقع |
