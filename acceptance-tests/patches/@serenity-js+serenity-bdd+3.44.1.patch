 exports.dashify = dashify;
 /**
  * @package
+ *
+ * Upstream uses \W (ASCII-only "non-word character"), which treats every non-Latin letter —
+ * Persian, Arabic, Cyrillic, CJK, etc. — as punctuation to strip. A scenario or Rule name written
+ * entirely in such a script then dashifies to an empty string, and Serenity BDD's Java aggregator
+ * silently drops any test outcome whose id is empty, undercounting the rendered report. \p{L}/\p{N}
+ * with the /u flag are Unicode-aware, so non-Latin letters and digits survive instead of being
+ * stripped. Patched via patch-package — see patches/@serenity-js+serenity-bdd+*.patch — because no
+ * released version fixes this (checked up to 3.45.7, the latest as of this patch).
  */
 function dashify(text) {
     return text
-        .replaceAll(/\W/g, '-')
+        .replaceAll(/[^\p{L}\p{N}]+/gu, '-')
         .replaceAll(/^-+|-+$/g, '')
         .toLowerCase();
 }
