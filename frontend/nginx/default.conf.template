# Templated by the nginx image's own entrypoint (20-envsubst-on-templates.sh): every
# *.template file under /etc/nginx/templates/ is run through envsubst into
# /etc/nginx/conf.d/ before nginx starts, substituting only variables that are actually set in
# the container's environment — nginx's own variables below ($uri, $host, $remote_addr, $scheme,
# ...) are untouched because none of them is also the name of a real env var. No custom
# entrypoint needed. See ../CLAUDE.md's "Production image" section for API_PROXY_TARGET.

gzip on;
gzip_types text/plain text/css text/javascript application/javascript application/json application/x-javascript;

server {
    listen 80;

    # Docker's embedded DNS server, reachable on every user-defined network — what lets
    # API_PROXY_TARGET's host resolve lazily, at request time, instead of once at nginx startup.
    # See the comment on the location below.
    resolver 127.0.0.11 valid=10s;

    # SPA fallback: Angular is client-routed, so a hard refresh on a deep link (e.g. /boms/123)
    # must still resolve to index.html rather than 404ing on a path nginx doesn't have a file for.
    root /usr/share/nginx/html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # outputHashing: "all" (angular.json) means every JS/CSS filename changes when its content
    # does, so it is safe — correct, not just fast — to cache these forever.
    location ~* \.(?:js|css)$ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # index.html names the current hashed bundles, so it must never come from a cache: a stale
    # copy would keep pointing at chunks that no longer exist once the next build is deployed.
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # The reverse proxy: same origin as the static files, so the backend needs no CORS and the
    # generated API client's relative routes (/api/users, ...) resolve without a baked-in base
    # URL. API_PROXY_TARGET is the same name, and the same concept — "where /api forwards to" —
    # that proxy.conf.mjs uses for the dev server; see that file's comments. In dev it names
    # host.docker.internal because the backend is a separate Compose project reachable only
    # through a published host port. Here it names whatever host actually serves the API in this
    # deployment (a Compose service name, a Kubernetes service, ...) — set at container run time,
    # defaulted in Dockerfile.prod.
    location /api/ {
        # A bare `proxy_pass ${API_PROXY_TARGET};` resolves that hostname once, at config load,
        # and refuses to start nginx at all if it doesn't resolve yet — fatal the moment this
        # container starts before its backend does, or stands alone with none. Assigning it to a
        # variable first defers resolution to request time via the `resolver` above (Docker's
        # embedded DNS, on every user-defined network), so the static site still serves with no
        # backend reachable; only a request under /api/ would 502.
        set $api_proxy_target ${API_PROXY_TARGET};
        proxy_pass $api_proxy_target;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
