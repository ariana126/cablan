# The staging stack's configuration — keys only, placeholder values.
#
# The real file lives on the team server at /home/github-runner/cablan-staging.env (mode 600,
# owner github-runner), never in this repo; `make staging/deploy` reads it from there by default
# (override with STAGING_ENV_FILE=...). IMAGE_TAG is not here: the deploy passes the short commit
# SHA of the images deploy-staging.yml just pushed.

# Hamravesh's registry address and the two Darkube app names — the same values as the repo's
# HAMRAVESH_REGISTRY, DARKUBE_BACKEND_APP_NAME and DARKUBE_FRONTEND_APP_NAME variables, since
# staging runs the very images production will.
REGISTRY=registry.example.com/team
BACKEND_APP_NAME=cablan-backend
FRONTEND_APP_NAME=cablan-frontend

# Loopback port the frontend container publishes; nginx on :18091 proxies to it behind Authelia.
STAGING_PORT=18092

# Staging's own Postgres (persistent volume cablan-staging-db).
POSTGRES_PASSWORD=change-me

# Backend secrets. DEFAULT_ADMIN_* seed the first System Admin on an empty database only;
# changing them later does not reset an existing account.
JWT_SECRET=change-me
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change-me
